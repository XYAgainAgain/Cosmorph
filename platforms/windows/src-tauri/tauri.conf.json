{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmorph",
  "version": "0.1.0",
  "identifier": "app.cosmorph.wallpaper",
  "build": {
    "frontendDist": "../../..",
    "devUrl": "http://localhost:8787"
  },
  "app": {
    "windows": [
      {
        "label": "wallpaper",
        "title": "Cosmorph",
        "url": "/platforms/windows/wallpaper.html",
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
