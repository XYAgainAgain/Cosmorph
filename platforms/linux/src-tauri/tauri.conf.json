{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmorph",
  "version": "0.1.0",
  "identifier": "app.cosmorph.wallpaper",
  "build": {
    "frontendDist": "../../..",
    "devUrl": "http://localhost:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "wallpaper",
        "title": "Cosmorph",
        "url": "/platforms/shared/wallpaper.html",
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'",
      "capabilities": ["wallpaper-events"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
